{
  "buildCommand": "npm run install:all && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": { "includeFiles": "server/dist/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}